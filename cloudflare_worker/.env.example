# Notify Jobs - Cloudflare Worker Environment Variables & Secrets
# Note: For production, set secrets via wrangler CLI:
#   npx wrangler secret put FIREBASE_SERVICE_ACCOUNT
#   npx wrangler secret put ADMIN_API_SECRET

ENVIRONMENT=production
FIREBASE_PROJECT_ID=notify-jobs-app

# Paste the raw JSON of your Firebase service account key into this secret:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@....iam.gserviceaccount.com"}

# Optional fallback secret for emergency admin calls
# ADMIN_API_SECRET=your-random-generated-secure-secret-token
